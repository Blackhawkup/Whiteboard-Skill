#!/usr/bin/env bash
# One command for the whiteboard-explainer skill: wb help
SKILL="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export WHITEBOARD_HOME="${WHITEBOARD_HOME:-$HOME/WhiteboardFilms}"
export PYTHONDONTWRITEBYTECODE=1
PY="$WHITEBOARD_HOME/.tools/venv/bin/python"
[ -x "$PY" ] || PY="$(command -v python3 || command -v python)"
[ -n "$PY" ] || { echo "Python is not installed. Mac: brew install python@3.12   Linux: sudo apt install python3 python3-venv"; exit 1; }
exec "$PY" "$SKILL/tools/wb.py" "$@"
